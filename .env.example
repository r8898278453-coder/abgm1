# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://bga.aaditechs.in)
APP_URL="https://bga.aaditechs.in"

# Port Configuration (Optional for Standalone VPS/Docker; defaults to 3000 in AI Studio sandbox)
APP_PORT="3000"

# Authentication & JWT Security Secret
# In production, set this to a strong random 32+ character secret string to sign and verify HMAC-SHA256 tokens
AUTH_SECRET="aaditech_bga_super_secret_jwt_key_replace_in_prod"

# Optional Initial Admin Bootstrap (No hardcoded credentials in source code)
# If provided, an initial admin user is created on startup if the database is empty
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="System Administrator"

# Hostinger MySQL Database Configuration
# Create a database in Hostinger hPanel -> Databases -> Management
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u123456789_bga_db"
DB_USER="u123456789_bga_user"
DB_PASSWORD="your_mysql_password_here"

# Telegram Bot (Optional for Real Smartphone Push Alerts)
# Create a bot via @BotFather on Telegram and get your Chat ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp Business Cloud API (Meta for Developers)
# Phone Number ID from Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=""
# Permanent System User Access Token from Meta Business Suite
WHATSAPP_ACCESS_TOKEN=""
# Custom webhook verification token for Meta webhook subscription
WHATSAPP_VERIFY_TOKEN="aaditech_bga_whatsapp_verify_token"

# Razorpay Payment Gateway (UPI, Cards, NetBanking, Subscriptions)
# Key ID and Key Secret from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook Secret from Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=""
