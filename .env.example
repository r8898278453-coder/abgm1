# ==============================================================================
# LOCALPULSE / AADITECH BGA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env on your deployment host and fill in authentic values.
# NEVER commit .env or real credentials to source control.

# ==============================================================================
# 1. DATABASE CONFIGURATION (Hostinger MySQL / MariaDB)
# ==============================================================================
# Hostinger hPanel -> Databases -> MySQL Databases
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u123456789_bga_prod"
DB_USER="u123456789_bga_admin"
DB_PASSWORD="your_strong_mysql_password_here"

# Alternative connection URI format (if provided by hosting provider):
# DATABASE_URL="mysql://u123456789_bga_admin:your_password@localhost:3306/u123456789_bga_prod"

# ==============================================================================
# 2. APPLICATION & RUNTIME ENVIRONMENT
# ==============================================================================
NODE_ENV="production"
IS_PRODUCTION="true"
PORT="3000"
APP_URL="https://bga.aaditechs.in"
TRUST_PROXY_HOPS="1"

# ==============================================================================
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS
# ==============================================================================
# Minimum 32-character random string for signing JWT authentication tokens
AUTH_SECRET="generate_a_random_32_character_cryptographic_secret_here"

# Optional explicit 32-character key for AES-256-GCM credential encryption at rest
# (If not provided, derived securely from AUTH_SECRET)
CREDENTIAL_ENCRYPTION_KEY=""

# ==============================================================================
# 4. INITIAL ADMINISTRATOR PROVISIONING (Optional First-Run Bootstrap)
# ==============================================================================
# If specified, automatically provisions the initial platform admin on deployment
INITIAL_ADMIN_EMAIL="admin@aaditechs.in"
INITIAL_ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"
INITIAL_ADMIN_NAME="System Administrator"

# ==============================================================================
# 5. AI ENGINE (Google Gemini API)
# ==============================================================================
# Gemini API Key for autonomous summary, content generation, and intent classification
GEMINI_API_KEY=""

# ==============================================================================
# 6. TRANSACTIONAL EMAIL (Password Reset & Account Security)
# ==============================================================================
# Option A: SMTP (Hostinger / Titan / Google Workspace)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="security@aaditechs.in"
SMTP_PASS="your_secure_mailbox_password"
SMTP_FROM="security@aaditechs.in"
SMTP_SECURE="true"

# Option B: Transactional Email API Services (Alternative to SMTP)
RESEND_API_KEY=""
SENDGRID_API_KEY=""
POSTMARK_SERVER_TOKEN=""

# ==============================================================================
# 7. TELEGRAM SECURITY & REAL-TIME ALERTS (Optional)
# ==============================================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ==============================================================================
# 8. PAYMENT & BILLING (Razorpay Multi-Tenant Subscriptions & Invoicing)
# ==============================================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ==============================================================================
# 9. PROVIDER INTEGRATIONS (Per-tenant by default, optional platform defaults)
# ==============================================================================
# WhatsApp Business Cloud API (Meta Developer Console)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="aaditech_bga_whatsapp_verify_token"

# Meta Social Publishing (Facebook Page & Instagram Graph API)
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""
META_INSTAGRAM_ACCOUNT_ID=""
META_APP_SECRET=""
