{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run db:check:sources && vite build && node --import tsx server/scripts/buildServer.ts",
    "start": "node dist/server.cjs",
    "db:migrate": "tsx server/scripts/dbMigrate.ts",
    "db:verify": "tsx server/scripts/dbVerify.ts",
    "db:setup": "tsx server/scripts/dbSetup.ts",
    "db:status": "tsx server/scripts/dbStatus.ts",
    "db:seed:system": "tsx server/scripts/dbSeedSystem.ts",
    "db:seed:demo": "tsx server/scripts/dbSeedDemo.ts",
    "admin:create": "tsx server/scripts/adminCreate.ts",
    "deploy:validate": "tsx server/scripts/deploymentValidate.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx server/scripts/testSuite.ts",
    "test:e2e": "tsx test/e2eUserJourneyAudit.test.ts",
    "test:billing": "tsx test/billingRazorpay.test.ts",
    "test:meta": "tsx test/metaWhatsApp.test.ts",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "build:mobile": "cross-env VITE_API_BASE_URL=https://bga.aaditechs.in vite build && cap sync",
    "test:queue:safety": "tsx test/queueExecutionSafety.test.ts",
    "test:health": "tsx test/healthRoutes.test.ts",
    "test:migrations:compatibility": "tsx test/migrationChecksumCompatibility.test.ts",
    "test:audit:privacy": "tsx test/auditLogPrivacy.test.ts",
    "test:queue:validation": "tsx test/queueValidation.test.ts",
    "test:queue:http": "tsx test/queueRoutes.test.ts",
    "test:browser:workspace": "node --import tsx test/browser/workspaceIsolation.test.ts",
    "test:sql:local": "node --import tsx server/scripts/testLocalSql.ts",
    "test:schema:indexes": "node --import tsx test/schemaIndexEquivalence.test.ts",
    "test:queue:leases": "node --import tsx test/queueLeaseFencing.test.ts",
    "test:browser:company": "node --import tsx test/browser/companyCreation.test.ts",
    "test:browser:dispatcher": "node --import tsx test/browser/dispatcherHistory.test.ts",
    "test:sql:restore": "node --import tsx server/scripts/testLocalSql.ts --restore",
    "test:browser:website": "node --import tsx test/browser/websiteIsolation.test.ts",
    "test:browser:observations": "node --import tsx test/browser/observationTruth.test.ts",
    "test:browser:competitors": "node --import tsx test/browser/competitorWorkflow.test.ts",
    "test:browser:integrations": "node --import tsx test/browser/integrationIsolation.test.ts",
    "test:browser:knowledge": "node --import tsx test/browser/knowledgeWorkflow.test.ts",
    "db:check:sources": "node --import tsx server/scripts/checkMigrationSources.ts",
    "routes:check": "node --import tsx server/scripts/checkRoutes.ts",
    "routes:record": "node --import tsx server/scripts/checkRoutes.ts --write",
    "test:browser:campaigns": "node --import tsx test/browser/campaignPlanning.test.ts",
    "test:browser:facts": "node --import tsx test/browser/knowledgeFacts.test.ts",
    "docs:status": "node --import tsx server/scripts/implementationStatus.ts",
    "docs:check": "node --import tsx server/scripts/implementationStatus.ts --check",
    "test:browser:agency": "node --import tsx test/browser/agencyWorkspace.test.ts",
    "test:browser:onboarding": "node --import tsx test/browser/onboardingWorkflow.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@google/genai": "^2.4.0",
    "@remotion/bundler": "^4.0.526",
    "@remotion/renderer": "^4.0.526",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "colord": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "mysql2": "^3.24.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "parse5": "7.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "remotion": "^4.0.526",
    "satori": "^0.33.4",
    "vite": "^6.2.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
